# Supabase (official project URL only — no tunnels)
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<your-supabase-anon-key>"
VITE_SUPABASE_PROJECT_ID="local"

# Middleware is disabled in this build. Leave these unset — if set, the
# middleware client will still refuse to make network requests.
# VITE_API_BASE_URL=
# VITE_API_KEY=
# VITE_MIDDLEWARE_WS_URL=

# OneSignal
VITE_ONESIGNAL_APP_ID=""
VITE_VAPID_PUBLIC_KEY=""
